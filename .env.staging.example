# Public build-time values for the stable staging deployment.
# Configure these in the Vercel Preview/Custom staging environment.
# NEXT_PUBLIC_* values are visible in browser JavaScript and must never be secrets.
NEXT_PUBLIC_API_URL=https://api-staging.tienhoclaptrinh.site
NEXT_PUBLIC_WS_URL=wss://api-staging.tienhoclaptrinh.site/ws/chat
NEXT_PUBLIC_MEDIA_BASE_URL=https://images-staging.tienhoclaptrinh.site
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-staging-google-client-id
